{
  "name": "ct-reading-room-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare-public": "node scripts/copy-codecs.mjs && node scripts/case-index.mjs",
    "dev": "pnpm prepare-public && vite",
    "build": "pnpm prepare-public && pnpm typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "test": "vitest run",
    "deploy:check": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "upload-cases": "node scripts/upload-cases.mjs"
  },
  "dependencies": {
    "@cornerstonejs/core": "5.17.1",
    "@cornerstonejs/dicom-image-loader": "5.17.1",
    "@cornerstonejs/metadata": "5.17.1",
    "@cornerstonejs/tools": "5.17.1",
    "@cornerstonejs/utils": "5.17.1",
    "@kitware/vtk.js": "36.4.1",
    "d3-array": "3.2.4",
    "d3-interpolate": "3.0.1",
    "dicom-parser": "1.8.21",
    "events": "3.3.0",
    "gl-matrix": "3.4.3",
    "react": "19.2.9",
    "react-dom": "19.2.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261110.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.2.1",
    "typescript": "6.0.3",
    "vite": "8.1.7",
    "vitest": "5.1.0",
    "wrangler": "4.160.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
