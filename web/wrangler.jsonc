// Cloudflare Workers deployment (docs/deploying.md). Workers Builds runs
// `pnpm build` and then `npx wrangler deploy` with this file.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ct-reading-room",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/cases/index.json"]
  },
  // Once the R2 bucket exists, uncomment this so real cases are served from it.
  // "r2_buckets": [{ "binding": "CASES", "bucket_name": "ct-reading-room-cases" }]
}
