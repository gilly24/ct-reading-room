{
  "name": "ct-reading-room",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "postCreateCommand": "pip install --user uv && corepack enable && (cd pipeline && ~/.local/bin/uv sync --extra dev) && (cd web && pnpm install)",
  "forwardPorts": [5173],
  "portsAttributes": { "5173": { "label": "Reading room", "onAutoForward": "openBrowser" } },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "dbaeumer.vscode-eslint", "esbenp.prettier-vscode"]
    }
  }
}
